# ==============================================================================
# TUNQ - Intelligence Économique & Décision Produit
# Variables d'Environnement (Ne jamais commiter de secrets en clair !)
# ==============================================================================

# Turso Database (LibSQL Cloud / Edge)
# Obtenez vos clés via: https://turso.tech ou CLI: `turso db show <nom-db> --url` / `turso db tokens create <nom-db>`
# En local ou si non configuré, l'application bascule automatiquement sur la base SQLite locale: file:backend/data/ansd_master.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Google Gemini API
# Obtenez votre clé via: https://aistudio.google.com/app/apikey
# Si non configuré, le moteur d'arbitrage utilise le moteur heuristique ANSD calibré.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
